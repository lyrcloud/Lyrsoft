PORT=3000
# Public URL used in email links
BASE_URL=http://localhost:3000
NODE_ENV=development
# The super admin account (created on first boot)
SUPER_ADMIN_EMAIL=lyrclouds@gmail.com
DB_PATH=data/lyrsoft.db

# --- Lyrsoft Mail ---
# "log" writes every message to data/outbox/*.eml instead of sending (good for development)
# "smtp" delivers through the SMTP server below (Gmail app password, Amazon SES SMTP, Postmark, ...)
MAIL_TRANSPORT=log
MAIL_FROM="Lyrsoft <no-reply@lyrsoft.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_MAX_ATTEMPTS=5
MAIL_POLL_MS=5000
