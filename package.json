{
  "name": "lyrsoft",
  "version": "1.0.0",
  "description": "Lyrsoft — company website, Lyrsoft Hub work platform and Lyrsoft Mail delivery system",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "admin-link": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/admin-link.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^7.0.10"
  }
}
